{
  "name": "@swarakaka/bridge-vite",
  "version": "1.0.3",
  "description": "Vite plugin for Bridge: resolves page components from ./Pages without a resolve callback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swarakaka/bridge",
    "directory": "packages/vite"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
