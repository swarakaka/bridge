{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.swarakaka.dev/schemas/v1/page.schema.json",
  "title": "BridgePage",
  "description": "Bridge protocol v1 page object (spec/page.md §1).",
  "type": "object",
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "page" },
    "component": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^/" },
    "props": { "type": "object" },
    "build": { "type": ["string", "null"] },
    "deferred": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      }
    },
    "meta": {
      "type": "object",
      "description": "Additive extensions (spec/page.md §1). Clients MUST ignore unknown members.",
      "properties": {
        "merge": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Prop keys clients may append on opted-in partial reloads (§3)."
        },
        "prepend": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Prop keys clients may prepend on opted-in partial reloads (§3)."
        },
        "deepMerge": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Prop keys clients may deep-merge on opted-in partial reloads (§3)."
        },
        "matchOn": {
          "type": "object",
          "description": "Match paths per merge key: the last segment is the item key (§3).",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[^,\\s]+$" },
            "minItems": 1
          }
        },
        "encryptHistory": {
          "type": "boolean",
          "description": "Store this page encrypted in the client's history (§10)."
        },
        "clearHistory": {
          "type": "boolean",
          "description": "Make earlier encrypted history entries unreadable before storing this page (§10)."
        },
        "scroll": {
          "type": "object",
          "description": "Infinite-scroll ends per prop (§12).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "pageName": { "type": "string", "minLength": 1 },
              "dataPath": { "type": "string", "minLength": 1 },
              "currentPage": {
                "anyOf": [{ "type": "integer" }, { "type": "string" }, { "type": "null" }]
              },
              "previousPage": {
                "anyOf": [{ "type": "integer" }, { "type": "string" }, { "type": "null" }]
              },
              "nextPage": {
                "anyOf": [{ "type": "integer" }, { "type": "string" }, { "type": "null" }]
              }
            },
            "required": ["pageName", "dataPath", "currentPage", "previousPage", "nextPage"],
            "additionalProperties": false
          }
        },
        "watch": {
          "type": "object",
          "description": "Watched props: prop name → the watch tags it is built from (§13).",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[^*,\\s]+$" },
            "minItems": 1
          }
        },
        "once": {
          "type": "object",
          "description": "Once props this page considered: prop name → once key and expiry (§11).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "pattern": "^[^,\\s]+$" },
              "expiresAt": { "type": ["integer", "null"] }
            },
            "required": ["key", "expiresAt"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["protocol", "type", "component", "url", "props", "build"],
  "additionalProperties": false
}
