{
    "name": "bridge-playground",
    "private": true,
    "version": "0.0.0",
    "description": "Laravel + Vue playground demonstrating every Bridge mode; integration test environment",
    "$schema": "https://www.schemastore.org/package.json",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr resources/js/ssr.ts --outDir bootstrap/ssr",
        "build:client": "vite build",
        "build:ssr": "vite build --ssr resources/js/ssr.ts --outDir bootstrap/ssr",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "test": "php artisan test",
        "serve": "./serve.sh"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/tsconfig": "^0.7.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.8.0",
        "vite": "^8.0.0",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "@swarakaka/bridge-vue": "workspace:*",
        "vue": "^3.5.0"
    }
}
